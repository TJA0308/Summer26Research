"""
smote_doc.py — Synthetic DOC scalogram generation via raw-signal interpolation.

Creates synthetic vibration signals ONLY for DOC classes,
generates 10-window scalograms, and saves them into the
target scalogram directory.

Also writes:
    smote_doc_labels.csv

Usage:

python smote_doc.py \
    --data_dir ../data \
    --output_dir ../scalograms_10w \
    --n_synthetic 2 \
    --n_windows 10
"""

import argparse
import csv
import itertools
import random
import sys
from pathlib import Path

import numpy as np
import pandas as pd
from PIL import Image

sys.path.insert(0, str(Path(__file__).parent))

from scalogram import (
    analytic_morlet_cwt,
    build_rgb_image,
    FS,
    DOWNSAMPLE,
    F_MIN,
    F_MAX,
    N_FREQS,
    SIGMA,
    IMG_SIZE,
    CHANNELS,
)

from cnn_train import (
    DOC_LABELS,
    DOC_TEST_RUNS,
)

SEED = 42


# ------------------------------------------------------------
# Load vibration signal
# ------------------------------------------------------------
def load_signal(csv_path, channels):
    df = pd.read_csv(csv_path)
    return {
        ch: df[ch].values.astype(np.float32)
        for ch in channels
    }


# ------------------------------------------------------------
# Interpolate two same-class signals
# ------------------------------------------------------------
def interpolate_signals(sig_a, sig_b, alpha):
    return {
        ch: alpha * sig_a[ch] + (1.0 - alpha) * sig_b[ch]
        for ch in sig_a
    }


# ------------------------------------------------------------
# Convert signal -> wavelet powers
# ------------------------------------------------------------
def signal_to_powers(
    signal_dict,
    downsample,
    fs_eff,
    f_min,
    f_max,
    n_freqs,
    sigma
):
    powers = []

    for ch in CHANNELS:

        sig = signal_dict[ch][::downsample]

        # DC removal
        sig = sig - sig.mean()

        power, _ = analytic_morlet_cwt(
            sig,
            fs=fs_eff,
            n_freqs=n_freqs,
            f_min=f_min,
            f_max=f_max,
            sigma=sigma
        )

        powers.append(power)

    return powers


# ------------------------------------------------------------
# Save 10-window scalograms
# ------------------------------------------------------------
def save_windows(
    signal_dict,
    stem,
    output_dir,
    n_windows,
    downsample,
    fs_eff,
    f_min,
    f_max,
    n_freqs,
    sigma,
    img_size,
):

    N = len(next(iter(signal_dict.values())))

    window_size = N // 2

    hop = max(
        1,
        (N - window_size) // (n_windows - 1)
    ) if n_windows > 1 else N

    for w in range(n_windows):

        start = w * hop
        end   = start + window_size

        if end > N:
            end   = N
            start = max(0, end - window_size)

        win = {
            ch: signal_dict[ch][start:end]
            for ch in signal_dict
        }

        powers = signal_to_powers(
            win,
            downsample,
            fs_eff,
            f_min,
            f_max,
            n_freqs,
            sigma
        )

        img = build_rgb_image(
            powers,
            img_size
        )

        Image.fromarray(img).save(
            output_dir / f"{stem}_w{w + 1}.png"
        )


# ------------------------------------------------------------
# MAIN
# ------------------------------------------------------------
def main():

    parser = argparse.ArgumentParser(
        description="Generate synthetic DOC scalograms via signal interpolation."
    )

    parser.add_argument(
        "--data_dir",
        required=True,
        help="Folder containing raw CSV vibration files"
    )

    parser.add_argument(
        "--output_dir",
        required=True,
        help="Folder to save synthetic scalogram PNGs"
    )

    parser.add_argument(
        "--n_synthetic",
        type=int,
        default=2,
        help="Synthetic runs generated per class pair cycle"
    )

    parser.add_argument(
        "--n_windows",
        type=int,
        default=10,
        help="Number of scalogram windows per synthetic run"
    )

    args = parser.parse_args()

    random.seed(SEED)
    np.random.seed(SEED)

    data_dir   = Path(args.data_dir)
    output_dir = Path(args.output_dir)

    output_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    fs_eff = FS // DOWNSAMPLE

    # --------------------------------------------------------
    # DOC labels
    # --------------------------------------------------------
    all_labels = DOC_LABELS
    test_runs  = DOC_TEST_RUNS

    csv_name = "smote_doc_labels.csv"

    csv_fields = [
        "run",
        "label",
        "parent_a",
        "parent_b"
    ]

    # --------------------------------------------------------
    # Build class -> training runs
    # --------------------------------------------------------
    runs_by_class = {}

    for run, lbl in all_labels.items():

        if run not in test_runs:

            runs_by_class.setdefault(lbl, []).append(run)

    max_count = max(
        len(v)
        for v in runs_by_class.values()
    )

    print("\nDOC class distribution:")

    for c in sorted(runs_by_class):

        status = (
            "majority"
            if len(runs_by_class[c]) == max_count
            else f"need +{max_count - len(runs_by_class[c])}"
        )

        print(
            f"class {c}: "
            f"{len(runs_by_class[c])} runs "
            f"[{status}]"
        )

    print(f"\nMajority class size: {max_count}")

    label_rows   = []
    total_images = 0

    # --------------------------------------------------------
    # Generate synthetic signals
    # --------------------------------------------------------
    for cls in sorted(runs_by_class):

        runs = runs_by_class[cls]

        if len(runs) >= max_count:
            continue

        if len(runs) < 2:
            print(f"\nClass {cls}: only 1 run available")
            continue

        print(f"\nGenerating synthetic runs for DOC class {cls}")

        class_signals = {

            run: load_signal(
                data_dir / f"{run}.csv",
                CHANNELS
            )

            for run in runs
        }

        needed = max_count - len(runs)

        pairs = list(
            itertools.combinations(runs, 2)
        )

        pair_cycle = itertools.cycle(pairs)

        for idx in range(needed):

            run_a, run_b = next(pair_cycle)

            alpha = random.uniform(0.1, 0.9)

            syn = interpolate_signals(
                class_signals[run_a],
                class_signals[run_b],
                alpha
            )

            stem = f"smote_d{cls}_{idx}"

            save_windows(
                syn,
                stem,
                output_dir,
                args.n_windows,
                DOWNSAMPLE,
                fs_eff,
                F_MIN,
                F_MAX,
                N_FREQS,
                SIGMA,
                IMG_SIZE,
            )

            label_rows.append({
                "run": stem,
                "label": cls,
                "parent_a": run_a,
                "parent_b": run_b,
            })

            total_images += args.n_windows

            print(
                f"  {stem}  "
                f"alpha={alpha:.3f}  "
                f"({run_a} <-> {run_b})"
            )

    # --------------------------------------------------------
    # Save label CSV
    # --------------------------------------------------------
    lbl_path = output_dir / csv_name

    with open(lbl_path, "w", newline="") as f:

        writer = csv.DictWriter(
            f,
            fieldnames=csv_fields
        )

        writer.writeheader()
        writer.writerows(label_rows)

    print("\nDONE")
    print(f"{len(label_rows)} synthetic runs created")
    print(f"{total_images} synthetic images saved")
    print(f"Labels written to: {lbl_path}")

    print("\nNow run:")
    print(
        "python cnn_train.py "
        "--img_dir scalograms_10w "
        "--target doc "
        "--freeze "
        "--epochs 10"
    )


if __name__ == "__main__":
    main()